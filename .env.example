# ─── Resend (recommended) ─────────────────────────────────────────
# Create a key at https://resend.com — see docs/RESEND.md

# Use your verified domain in production, e.g.:
# CONTACT_FROM_EMAIL=Shindara Contact <hello@shindaraautos.com>
CONTACT_FROM_EMAIL=Shindara Contact <onboarding@resend.dev>
# Comma-separated — every enquiry, contact form, and newsletter goes to both
CONTACT_TO_EMAIL=hello@shindaraautos.com,oluwasina@shindaraautos.com

# ─── Optional Formspree fallback (used only if RESEND_API_KEY is empty)
# FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Public site URL used for canonical/OG metadata
NEXT_PUBLIC_SITE_URL=https://shindaraautos.com
